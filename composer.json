{
    "name": "verstka/sdk-php74",
    "description": "PHP 7.4 SDK for Verstka API v2: open editor sessions, verify callbacks, download and process material content (media + fonts).",
    "type": "library",
    "license": "MIT",
    "keywords": ["verstka", "sdk", "editor", "cms", "api", "php74"],
    "authors": [
        {
            "name": "Verstka"
        }
    ],
    "support": {
        "issues": "https://github.com/verstka/verstka-sdk-php74/issues",
        "source": "https://github.com/verstka/verstka-sdk-php74"
    },
    "require": {
        "php": ">=7.4 <8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-zip": "*",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Verstka\\Sdk\\": "src/Verstka/Sdk/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Verstka\\Sdk\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "7.4.0"
        },
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
